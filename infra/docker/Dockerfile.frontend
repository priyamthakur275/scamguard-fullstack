# syntax=docker/dockerfile:1
# Build context: frontend/
# Build with:  docker build -f infra/docker/Dockerfile.frontend -t scamguard-frontend frontend
#
# Unlike a typical Next.js app, APP_SERVICE_URL and ML_SERVICE_URL do NOT
# need to be build args: they're read server-side at runtime by
# next.config.js's rewrites() function, so the same image can point at
# different backend URLs in different environments just by changing the
# container's environment variables at `docker run` time.

FROM node:20-slim AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

# --------------------------------------------------------------------------

FROM node:20-slim AS builder
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# --------------------------------------------------------------------------

FROM node:20-slim AS runtime
WORKDIR /app

RUN addgroup --system appuser && adduser --system --ingroup appuser appuser

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

COPY --from=builder /app/public ./public
COPY --from=builder --chown=appuser:appuser /app/.next/standalone ./
COPY --from=builder --chown=appuser:appuser /app/.next/static ./.next/static

USER appuser
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://localhost:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
